generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model MenuItem {
  id        Int      @id @default(autoincrement())
  category  String
  name      String
  subtitle  String?
  price     String
  allergens String?
  available Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  date      String
  time      String
  guests    Int
  occasion  String?
  note      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model DailyMenu {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  items     String   @default("[]")
  price     String?
  note      String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}
